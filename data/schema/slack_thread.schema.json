{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "slack_thread.schema.json",
  "title": "Slack Incident Thread",
  "description": "Slack channel thread exported for an incident response",
  "type": "object",
  "required": ["channel", "incident_id", "thread_ts", "messages"],
  "additionalProperties": false,
  "properties": {
    "channel":     { "type": "string", "pattern": "^#" },
    "incident_id": { "type": "string", "pattern": "^INC-" },
    "thread_ts":   { "type": "string" },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/Message" }
    }
  },
  "definitions": {
    "Message": {
      "type": "object",
      "required": ["user", "timestamp", "text"],
      "additionalProperties": false,
      "properties": {
        "user":      { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "text":      { "type": "string" }
      }
    }
  }
}
