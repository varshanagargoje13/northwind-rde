{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "postmortem.schema.json",
  "title": "Incident Postmortem",
  "description": "Structured fields extracted from a postmortem markdown document. The source file is postmortem.md; this schema describes the parsed/extracted data structure that loaders produce.",
  "type": "object",
  "required": [
    "incident_id", "severity", "date", "author", "status",
    "root_cause", "impact_duration_hours", "orders_impacted", "action_items"
  ],
  "additionalProperties": false,
  "properties": {
    "incident_id":         { "type": "string", "pattern": "^INC-" },
    "severity":            { "type": "string", "enum": ["SEV-1", "SEV-2", "SEV-3", "SEV-4"] },
    "date":                { "type": "string", "format": "date" },
    "author":              { "type": "string" },
    "reviewers":           { "type": "array", "items": { "type": "string" } },
    "status":              { "type": "string", "enum": ["DRAFT", "IN REVIEW", "APPROVED"] },
    "summary":             { "type": "string" },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["time_utc", "event"],
        "additionalProperties": false,
        "properties": {
          "time_utc": { "type": "string" },
          "event":    { "type": "string" }
        }
      }
    },
    "root_cause":             { "type": "string" },
    "primary_root_cause":     { "type": "string" },
    "contributing_factors":   { "type": "array", "items": { "type": "string" } },
    "impact_duration_hours":  { "type": "number", "minimum": 0 },
    "orders_impacted":        { "type": "integer", "minimum": 0 },
    "revenue_at_risk_usd":    { "type": "number", "minimum": 0 },
    "customers_affected":     { "type": "integer", "minimum": 0 },
    "incident_start_time":    { "type": "string", "format": "date-time" },
    "resolution_time":        { "type": "string", "format": "date-time" },
    "action_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["owner", "item", "due"],
        "additionalProperties": false,
        "properties": {
          "owner": { "type": "string" },
          "item":  { "type": "string" },
          "due":   { "type": "string", "format": "date" }
        }
      }
    },
    "what_went_well":   { "type": "array", "items": { "type": "string" } },
    "what_went_poorly": { "type": "array", "items": { "type": "string" } }
  }
}
