{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "jira_tickets.schema.json",
  "title": "Jira Engineering Ticket Feed",
  "description": "Engineering sprint ticket export for an incident — includes bugs, tasks, and deferred items",
  "type": "object",
  "required": ["project", "sprint", "tickets"],
  "additionalProperties": false,
  "properties": {
    "project": { "type": "string" },
    "sprint":  { "type": "string" },
    "tickets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/Ticket" }
    }
  },
  "definitions": {
    "Ticket": {
      "type": "object",
      "required": ["id", "type", "priority", "status", "title", "reporter", "assignee", "created", "updated", "description"],
      "properties": {
        "id":                       { "type": "string" },
        "type":                     { "type": "string", "enum": ["Bug", "Task", "Story", "Epic", "Sub-task"] },
        "priority":                 { "type": "string", "enum": ["Critical", "High", "Medium", "Low"] },
        "status":                   { "type": "string", "enum": ["Open", "In Progress", "In Review", "Done", "Backlog", "Closed"] },
        "title":                    { "type": "string" },
        "reporter":                 { "type": "string" },
        "assignee":                 { "type": "string" },
        "created":                  { "type": "string", "format": "date-time" },
        "updated":                  { "type": "string", "format": "date-time" },
        "description":              { "type": "string" },
        "root_cause_hypothesis":    { "type": "string" },
        "estimated_orders_impacted":{ "type": ["string", "integer"] },
        "fix_description":          { "type": ["string", "null"] },
        "fix_deployed":             { "type": ["string", "null"] },
        "deployed_at":              { "type": "string", "format": "date-time" },
        "canary_percentage":        { "type": "integer", "minimum": 0, "maximum": 100 },
        "canary_result":            { "type": "string", "enum": ["Passed", "Failed", "Inconclusive"] },
        "orders_affected":          { "type": "array", "items": { "type": "string" } },
        "deferred_reason":          { "type": "string" },
        "smoking_gun_note":         { "type": "string" },
        "linked_issues":            { "type": "array", "items": { "type": "string" } },
        "comments": {
          "type": "array",
          "items": { "$ref": "#/definitions/Comment" }
        }
      }
    },
    "Comment": {
      "type": "object",
      "required": ["author", "timestamp", "body"],
      "additionalProperties": false,
      "properties": {
        "author":    { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "body":      { "type": "string" }
      }
    }
  }
}
